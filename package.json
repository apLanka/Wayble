{
  "name": "se3080-assignment1",
  "private": true,
  "version": "1.0.0",
  "packageManager": "bun@1.3.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "bun run scripts/sync-convex-env.ts && turbo run dev",
    "seed": "bun run --filter @packages/backend seed",
    "lint": "turbo run lint",
    "check-types": "tsc --noEmit && turbo run check-types",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,cjs,md,json,yml,yaml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,cjs,md,json,yml,yaml}\"",
    "test": "bun test scripts/",
    "prepare": "husky"
  },
  "devDependencies": {
    "@repo/typescript-config": "*",
    "@types/bun": "^1.2.19",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "~6.0.3"
  },
  "engines": {
    "node": ">=18"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs,md,json,yml,yaml}": "prettier --write"
  },
  "dependencies": {
    "expo": "~57.0.7",
    "react": "19.2.3",
    "react-native": "0.86.0"
  }
}
